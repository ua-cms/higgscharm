RETRY S_prod_2023postBPix_sig 1
JOB ZX_prod zx.sub
VARS ZX_prod model="prod"
RETRY ZX_prod 1
PARENT ZXB CHILD ZX_prod
JOB CARD_prod card.sub
VARS CARD_prod model="prod"
PARENT  S_prod_2022preEE_bkg S_prod_2022preEE_sig S_prod_2022postEE_bkg S_prod_2022postEE_sig S_prod_2023preBPix_bkg S_prod_2023preBPix_sig S_prod_2023postBPix_bkg S_prod_2023postBPix_sig ZX_prod SUMW CHILD CARD_prod
PARENT  S_prod_2022preEE_bkg S_prod_2022preEE_sig S_prod_2022postEE_bkg S_prod_2022postEE_sig S_prod_2023preBPix_bkg S_prod_2023preBPix_sig S_prod_2023postBPix_bkg S_prod_2023postBPix_sig CHILD SUMW
