# 2026-10-29: massinvlep rerun with the jet-kinematics-fixed Z+X (scored dirs were deleted 10-28 -> rescore) -> score, Z+X, CARD (1D optbin10 + validation + sculpting), 2D cat40.
JOB S_2022preEE_bkg score.sub
VARS S_2022preEE_bkg model="massinvlep" era="2022preEE" kind="bkg"
RETRY S_2022preEE_bkg 1
JOB S_2022preEE_sig score.sub
VARS S_2022preEE_sig model="massinvlep" era="2022preEE" kind="sig"
RETRY S_2022preEE_sig 1
JOB S_2022postEE_bkg score.sub
VARS S_2022postEE_bkg model="massinvlep" era="2022postEE" kind="bkg"
RETRY S_2022postEE_bkg 1
JOB S_2022postEE_sig score.sub
VARS S_2022postEE_sig model="massinvlep" era="2022postEE" kind="sig"
RETRY S_2022postEE_sig 1
JOB S_2023preBPix_bkg score.sub
VARS S_2023preBPix_bkg model="massinvlep" era="2023preBPix" kind="bkg"
RETRY S_2023preBPix_bkg 1
JOB S_2023preBPix_sig score.sub
VARS S_2023preBPix_sig model="massinvlep" era="2023preBPix" kind="sig"
RETRY S_2023preBPix_sig 1
JOB S_2023postBPix_bkg score.sub
VARS S_2023postBPix_bkg model="massinvlep" era="2023postBPix" kind="bkg"
RETRY S_2023postBPix_bkg 1
JOB S_2023postBPix_sig score.sub
VARS S_2023postBPix_sig model="massinvlep" era="2023postBPix" kind="sig"
RETRY S_2023postBPix_sig 1
JOB ZX zx.sub
VARS ZX model="massinvlep"
RETRY ZX 1
JOB CARD card.sub
VARS CARD model="massinvlep"
PARENT  S_2022preEE_bkg S_2022preEE_sig S_2022postEE_bkg S_2022postEE_sig S_2023preBPix_bkg S_2023preBPix_sig S_2023postBPix_bkg S_2023postBPix_sig ZX CHILD CARD
# 10-28: 2D optimised (cat40 only) in the same DAG
JOB DUMP dump_model.sub DIR /afs/cern.ch/user/s/snandaku/condor_hczz_2026_10_27_opt2d
VARS DUMP model="massinvlep"
RETRY DUMP 1
JOB OPT opt_layouts.sub DIR /afs/cern.ch/user/s/snandaku/condor_hczz_2026_10_27_opt2d
VARS OPT model="massinvlep"
RETRY OPT 1
PARENT S_2022preEE_bkg S_2022preEE_sig S_2022postEE_bkg S_2022postEE_sig S_2023preBPix_bkg S_2023preBPix_sig S_2023postBPix_bkg S_2023postBPix_sig ZX CHILD DUMP
