VARS S_2022postEE_sig model="fsextdisco0p1" era="2022postEE" kind="sig"
RETRY S_2022postEE_sig 1
JOB S_2023preBPix_bkg score.sub
VARS S_2023preBPix_bkg model="fsextdisco0p1" era="2023preBPix" kind="bkg"
RETRY S_2023preBPix_bkg 1
JOB S_2023preBPix_sig score.sub
