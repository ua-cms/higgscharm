# 2026-10-28 eve (user): rerun massinvlepdisco0p5 with the per-jet Z+X (old results renamed *_oldzx); scoring reused
JOB ZX zx.sub
VARS ZX model="massinvlepdisco0p5"
RETRY ZX 1
JOB CARD card.sub
VARS CARD model="massinvlepdisco0p5"
PARENT ZX CHILD CARD
JOB DUMP dump_model.sub DIR /afs/cern.ch/user/s/snandaku/condor_hczz_2026_10_27_opt2d
VARS DUMP model="massinvlepdisco0p5"
RETRY DUMP 1
JOB OPT opt_layouts.sub DIR /afs/cern.ch/user/s/snandaku/condor_hczz_2026_10_27_opt2d
VARS OPT model="massinvlepdisco0p5"
RETRY OPT 1
PARENT ZX CHILD DUMP
PARENT DUMP CHILD OPT
